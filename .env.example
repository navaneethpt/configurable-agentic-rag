# One application-wide provider: gemini (default) or groq. Restart after changes.
LLM_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: provider default model. Agents can override it with a model from that provider.
# LLM_MODEL=gemini-3.8-flash
# Groq example: LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-20b
# Optional: SQLite path for saved workflows (defaults to .data/workflows.sqlite3).
# FOLIO_WORKFLOWS_DB=/absolute/path/workflows.sqlite3
# Optional: trusted Python modules that register additional agent/tool types.
# FOLIO_NODE_MODULES=rag_chat.extensions.my_nodes
