# One application-wide provider: openrouter (default), gemini or groq. Restart after changes.
LLM_PROVIDER=openrouter
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the selected provider's default model. Agents may also override it.
# OpenRouter default:
# LLM_MODEL=liquid/lfm-2.5-2.6b:free
# Gemini example: LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.8-flash
# Groq example: LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-20b
# OpenRouter requires OPENROUTER_API_KEY; LLM_MODEL can be omitted for the default above.
# Choose an OpenRouter model ID whose endpoints support native JSON-schema outputs.
# Optional: SQLite path for saved workflows (defaults to .data/workflows.sqlite3).
# FOLIO_WORKFLOWS_DB=/absolute/path/workflows.sqlite3
# Optional: trusted Python modules that register additional agent/tool types.
# FOLIO_NODE_MODULES=rag_chat.extensions.my_nodes
